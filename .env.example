CINEFORGE_ENV=local
CINEFORGE_LOG_LEVEL=INFO
CINEFORGE_DATABASE_URL=sqlite:///./storage/cineforge_local.db
CINEFORGE_COMFYUI_BASE_URL=http://127.0.0.1:8188
# Trusted local supervisor configuration. Launcher must remain inside the working directory.
# CINEFORGE_COMFYUI_WORKING_DIR=C:\AI\ComfyUI_windows_portable
# CINEFORGE_COMFYUI_LAUNCHER=C:\AI\ComfyUI_windows_portable\run_nvidia_gpu.bat
# CINEFORGE_COMFYUI_STARTUP_TIMEOUT_SEC=180
# CINEFORGE_BACKEND_PORT=8010
# CINEFORGE_FRONTEND_PORT=5174
CINEFORGE_STORAGE_ROOT=./storage
CINEFORGE_ALLOW_ABSOLUTE_INPUT_PATHS=false
CINEFORGE_QUEUE_WORKER_ENABLED=false
CINEFORGE_AUTONOMY_MODE=scaffold_only
CINEFORGE_CORS_ALLOWED_ORIGINS=["http://127.0.0.1:5180","http://localhost:5180","http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:5174","http://localhost:5174","http://127.0.0.1:5175","http://localhost:5175"]

# Optional hosted planning provider. Leave disabled until a secret is supplied
# through the local environment; never commit a real key.
CINEFORGE_OPENAI_PLANNING_ENABLED=false
CINEFORGE_OPENAI_API_KEY=
CINEFORGE_OPENAI_BASE_URL=https://api.openai.com/v1
CINEFORGE_OPENAI_LOGICAL_MODEL_SOL=gpt-4.1
CINEFORGE_OPENAI_LOGICAL_MODEL_TERRA=gpt-4o
CINEFORGE_OPENAI_LOGICAL_MODEL_LUNA=gpt-4o-mini
CINEFORGE_OPENAI_TIMEOUT_SEC=60
CINEFORGE_OPENAI_WALL_TIME_SEC=120
CINEFORGE_OPENAI_TRANSPORT_RETRIES=2

# Existing Qwen TTS discovery. On the target workstation the bounded defaults
# under C:\AI are reused; these values only override an approved installation.
# Enabling without runtime and model evidence does not claim availability.
# CINEFORGE_LOCAL_AI_ROOT=C:\AI
# CINEFORGE_QWEN_LOCAL_RUNTIME=C:\AI\Qwen3-TTS
# CINEFORGE_QWEN_LOCAL_VENV=C:\AI\qwen3-tts-env
# CINEFORGE_QWEN_LOCAL_MODEL=C:\AI\Qwen3-TTS-12Hz-1.7B-Base

# Optional Parler-TTS remains unavailable unless every explicit approval and
# pre-existing local reference below is supplied. CineForge never installs it.
CINEFORGE_PARLER_APPROVED=false
CINEFORGE_PARLER_RUNTIME_REF=
CINEFORGE_PARLER_RUNTIME_APPROVED=false
CINEFORGE_PARLER_MODEL_REF=
CINEFORGE_PARLER_MODEL_APPROVED=false

